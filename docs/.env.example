# ECHO env vars
# Copy this file to `.env` and fill in your external Supabase project's
# publishable credentials. Both values are safe to expose to the browser.
# The service-role key must never be placed here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY
